<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri merges this into the generated app before every iOS build.
       iOS 17+ applies ATS to IP addresses; only the native media loopback
       transport needs an HTTP exception. Earlier iOS versions allow IPs. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>127.0.0.1</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
      </dict>
    </dict>
  </dict>
  <key>NSCameraUsageDescription</key>
  <string>扫描电视端二维码以配置视频源并同步数据</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>发现并连接同一局域网内的电视端以推送视频源与同步数据</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.hghubx.app</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>hghubx</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
